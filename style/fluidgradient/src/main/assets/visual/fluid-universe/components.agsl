uniform shader image;
uniform float2 textureSize, resolution, extent, origin, finger;
uniform float time, pressure, releaseAge, material, pageAge;

float liquid(float2 uv) {
    float2 touch=uv-finger;
    float angle=pressure*exp(-dot(touch,touch)*9.)*sin(time*.8);
    uv+=float2(-touch.y,touch.x)*angle*.4;
    float first=exp(-dot(uv-float2(.24+.14*sin(time*.22),.38+.17*cos(time*.19)),uv-float2(.24+.14*sin(time*.22),.38+.17*cos(time*.19)))*9.);
    float second=exp(-dot(uv-float2(.73+.12*cos(time*.18),.64+.16*sin(time*.24)),uv-float2(.73+.12*cos(time*.18),.64+.16*sin(time*.24)))*11.);
    float noise=sin(uv.x*8.+time*.32)*cos(uv.y*7.-time*.29)*.055;
    return first+second+noise;
}
half4 main(float2 point) {
    float2 uv=point/extent;
    float2 centered=point-extent*.5;
    float radius=(material==0.||material==1.||material==4.||material==5.||material==8.)?min(extent.x,extent.y)*.5-4.:min(extent.y*.28,54.);
    float2 outside=abs(centered)-(extent*.5-radius-4.);
    float distance=length(max(outside,0.))+min(max(outside.x,outside.y),0.)-radius;
    float edgeMotion=(sin(uv.x*6.+time*.5)+cos(uv.y*5.-time*.4))*min(extent.y*.018,4.);
    distance+=edgeMotion*(material==2.||material==5.?1.:.3);
    if(material==6.) {
        float cell=extent.x/3.;
        float2 local=float2(mod(point.x,cell)-cell*.5,point.y-extent.y*.5);
        float r=extent.y*.42;
        float2 q=abs(local)-float2(cell*.5-r-6.,extent.y*.5-r-4.);
        distance=length(max(q,0.))+min(max(q.x,q.y),0.)-r;
    }
    float density=liquid(uv);
    float epsilon=.01;
    float2 gradient=float2(liquid(uv+float2(epsilon,0.))-liquid(uv-float2(epsilon,0.)),liquid(uv+float2(0.,epsilon))-liquid(uv-float2(0.,epsilon)))/epsilon;
    float3 normal=normalize(float3(-gradient*.22,1.));
    float3 light=normalize(float3(finger.x-.5,.3-finger.y,1.));
    float specular=pow(max(dot(normal,light),0.),22.);
    float rim=1.-smoothstep(0.,8.,-distance);
    float colorField=clamp(density*.65+pageAge*.25,0.,1.);
    half3 liquidColor=mix(half3(.02,.18,.52),half3(.34,.06,.5),colorField);
    liquidColor=mix(liquidColor,half3(.02,.52,.40),smoothstep(.7,1.25,density));
    float strength=material==0.||material==4.?1.:.38;
    if(material==3.||material==8.) strength=.18;
    half3 color=half3(.016,.03,.05)+liquidColor*strength;
    color+=image.eval(clamp(uv*.65+float2(.12,.2)+normal.xy*.06,0.,1.)*textureSize).rgb*.08*strength;
    color+=half3(.32,.66,.70)*specular*.25*strength+half3(.08,.35,.38)*rim*.5;
    float2 touch=uv-finger;
    float wave=exp(-abs(length(touch)-releaseAge*.7)*23.)*exp(-releaseAge*4.);
    color+=half3(.12,.45,.35)*(wave*.3+pressure*exp(-dot(touch,touch)*12.)*.15);
    float alpha=1.-smoothstep(-1.5,0.,distance);
    return half4(color*alpha,alpha);
}
